# ==============================================================================
# Studexo Environment Template (Placeholders Only — Never Commit Real Secrets)
# ==============================================================================

# --- Required / Core Application Runtime ---
NODE_ENV="development"
PORT="3000"
# APP_URL: Public base URL where this application is hosted (injected by AI Studio / Cloud Run).
APP_URL="http://localhost:3000"
# Optional comma-separated extra CORS origins
ALLOWED_ORIGINS=""
# Optional comma-separated explicit HTTPS origins allowed to embed the app in an iframe in production.
# Leave empty in standalone production (enforces frame-ancestors 'none'). Wildcards are rejected.
CSP_FRAME_ANCESTORS=""
# Immediate reverse-proxy hops to trust (1 for Nginx/Cloud Run LB, 0 to disable)
TRUST_PROXY_HOPS="1"
# Structured logger level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# --- Optional: Database (Server-Only — NEVER expose to client) ---
# Runtime API pool (studexo_app): Supavisor Transaction Pooler URL (port 6543, prepare: false)
# In NODE_ENV=production, verified TLS is mandatory (do not use sslmode=require or sslmode=disable).
DATABASE_URL=""
# Direct / Session URL (port 5432, studexo_migrator) for Drizzle migrations only
DIRECT_DATABASE_URL=""
# Dedicated Background Purge Worker pool (studexo_purge_worker, prepare: false)
# Not required by the API process; worker entrypoints fail closed when unset.
WORKER_DATABASE_URL=""
WORKER_DB_POOL_MAX="2"
# Optional PEM CA bundle for custom/private Postgres TLS certificate chain verification
DB_SSL_ROOT_CERT=""
# Optional bounded connection pool settings (defaults: 5, 20, 10)
DB_POOL_MAX="5"
DB_IDLE_TIMEOUT_SECONDS="20"
DB_CONNECT_TIMEOUT_SECONDS="10"

# --- Optional: Supabase (Server-Only Admin + Public Client Config) ---
# Server-only service role key (bypasses RLS — NEVER prefix with VITE_)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Client-exposed public Supabase identifiers (safe only with RLS enabled)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Optional: Gemini AI Orchestration (Server-Only — NEVER expose to client) ---
GEMINI_API_KEY=""
